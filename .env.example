PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/quickbite
JWT_SECRET=replace_with_a_long_random_secret_at_least_24_chars
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@quickbite.demo
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# SMTP settings required for Forgot Password email links
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=QuickBite <your-email@gmail.com>

# Dispatch options (optional)
AUTO_DISPATCH_ENABLED=false
# Generic external courier/aggregator adapter. Configure with the API endpoint and token
# supplied by your courier vendor/aggregator; the provider must accept QuickBite's JSON payload.
COURIER_PROVIDER_NAME=Your Courier Provider
COURIER_API_URL=
COURIER_API_TOKEN=
COURIER_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret
COURIER_WEBHOOK_URL=https://your-public-api.example.com/api/courier/webhook

